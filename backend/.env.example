NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/learnly_lms
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Required only when running npm run seed. Set each to a unique, strong password.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Optional OpenAI-compatible HTTPS chat completion endpoint.
# Without AI_API_KEY, the student assistant explicitly runs in demo mode.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional Judge0-compatible HTTPS sandbox. Without a URL, execution returns a clear configuration error.
CODE_RUNNER_API_URL=
CODE_RUNNER_API_KEY=
CODE_RUNNER_PYTHON_ID=71
CODE_RUNNER_C_ID=50
CODE_RUNNER_CPP_ID=54
CODE_RUNNER_JAVA_ID=62
